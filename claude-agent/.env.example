# Copy this file to .env and fill in your key. .env is gitignored.
# Get a key from the Anthropic Console (workspace with Managed Agents beta access).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used by setup.ps1 / setup.sh
# ANTHROPIC_MODEL=claude-sonnet-4-5

# These are written automatically by setup.ps1 into .env.local + ids.json:
# ANTHROPIC_AGENT_ID=
# ANTHROPIC_AGENT_VERSION=
# ANTHROPIC_ENVIRONMENT_ID=
