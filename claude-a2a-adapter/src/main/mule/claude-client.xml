<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- ================================================================
         Claude Managed Agents API client (thin, reusable sub-flows).
         All calls require: x-api-key, anthropic-version, anthropic-beta.
         Inputs are taken from flow vars; outputs are left in `payload`
         and commonly captured into a var by the caller.
         ================================================================ -->

    <!-- Builds the shared auth/beta headers once per flow into vars.anthropicHeaders. -->
    <sub-flow name="claude-headers" doc:name="claude-headers">
        <set-variable variableName="anthropicHeaders" doc:name="anthropic headers"
            value="#[output application/java
---
{
  'x-api-key': (p('claude.apiKey') default p('secure::claude.apiKey')),
  'anthropic-version': p('claude.anthropicVersion'),
  'anthropic-beta': p('claude.betaHeader'),
  'content-type': 'application/json'
}]"/>
    </sub-flow>

    <!-- POST /v1/sessions  -> creates a session; stores new id in vars.sessionId. -->
    <sub-flow name="claude-create-session" doc:name="claude-create-session">
        <flow-ref name="claude-headers" doc:name="headers"/>
        <http:request method="POST" path="/v1/sessions" config-ref="Anthropic_API_config" doc:name="POST /v1/sessions">
            <http:body><![CDATA[#[output application/json
---
{
  agent: p('claude.agentId'),
  environment_id: p('claude.environmentId')
}]]]></http:body>
            <http:headers>#[vars.anthropicHeaders]</http:headers>
        </http:request>
        <set-variable variableName="sessionId" value="#[output application/java --- payload.id]" doc:name="sessionId"/>
        <logger level="INFO" message="#[output application/java --- ('Created Claude session ' ++ vars.sessionId ++ ' for context ' ++ vars.contextId)]"/>
    </sub-flow>

    <!-- POST /v1/sessions/{id}/events  -> sends a user.message built from vars.userPrompt. -->
    <sub-flow name="claude-send-message" doc:name="claude-send-message">
        <flow-ref name="claude-headers" doc:name="headers"/>
        <http:request method="POST" path="#['/v1/sessions/' ++ vars.sessionId ++ '/events']"
                      config-ref="Anthropic_API_config" doc:name="POST events (user.message)">
            <http:body><![CDATA[#[output application/json
---
{
  events: [
    {
      "type": "user.message",
      content: [ { "type": "text", text: vars.userPrompt } ]
    }
  ]
}]]]></http:body>
            <http:headers>#[vars.anthropicHeaders]</http:headers>
        </http:request>
    </sub-flow>

    <!-- POST /v1/sessions/{id}/events  -> sends a user.interrupt (for tasks/cancel). -->
    <sub-flow name="claude-interrupt" doc:name="claude-interrupt">
        <flow-ref name="claude-headers" doc:name="headers"/>
        <http:request method="POST" path="#['/v1/sessions/' ++ vars.sessionId ++ '/events']"
                      config-ref="Anthropic_API_config" doc:name="POST events (user.interrupt)">
            <http:body><![CDATA[#[output application/json --- { events: [ { "type": "user.interrupt" } ] }]]]></http:body>
            <http:headers>#[vars.anthropicHeaders]</http:headers>
        </http:request>
    </sub-flow>

    <!-- POST /v1/sessions/{id}/events -> one or more user.tool_confirmation events.
         Expects vars.confirmEvents = [ { tool_use_id, result ('allow'|'deny'), denyMessage? } ].
         Used both for inline auto-decisions (policy allow/deny) and the caller's HITL continuation. -->
    <sub-flow name="claude-send-confirmations" doc:name="claude-send-confirmations">
        <flow-ref name="claude-headers" doc:name="headers"/>
        <http:request method="POST" path="#['/v1/sessions/' ++ vars.sessionId ++ '/events']"
                      config-ref="Anthropic_API_config" doc:name="POST events (tool_confirmation)">
            <http:body><![CDATA[#[output application/json
---
{
  events: ((vars.confirmEvents default []) map ((c) ->
    ({
      "type": "user.tool_confirmation",
      tool_use_id: c.tool_use_id,
      result: c.result
    } ++ (if ((c.result default "") == "deny" and (c.denyMessage default "") != "")
            { deny_message: c.denyMessage } else {}))))
}]]]></http:body>
            <http:headers>#[vars.anthropicHeaders]</http:headers>
        </http:request>
    </sub-flow>

    <!-- GET /v1/sessions/{id}/events/stream  -> live SSE event stream (text/event-stream).
         The requester returns a deferred response stream (after headers); we consume events
         incrementally then break, so the never-ending body is never fully buffered.
         Mule parses text/event-stream into a lazily-iterable Array<{data, event, id, ...}>. -->
    <sub-flow name="claude-open-event-stream" doc:name="claude-open-event-stream">
        <flow-ref name="claude-headers" doc:name="headers"/>
        <http:request method="GET" path="#['/v1/sessions/' ++ vars.sessionId ++ '/events/stream']"
                      config-ref="Anthropic_SSE_config" responseTimeout="600000"
                      doc:name="GET events/stream (SSE)" requestStreamingMode="ALWAYS">
            <non-repeatable-stream />
			<http:headers><![CDATA[#[vars.anthropicHeaders ++ {'accept': 'text/event-stream'}]]]></http:headers>
        </http:request>
        <!-- Streaming-aware pass-through. Iterate on output type / options here to coax a
             lazily-iterable event collection out of the SSE response for the caller's foreach.
             (Plain valid pass-through to start; deferred=true is valid for json/xml/csv, not java.) -->
        <ee:transform doc:name="stream-through SSE">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
input payload
output application/java
---
payload as Iterator]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </sub-flow>

</mule>
